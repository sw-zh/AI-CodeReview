# Copy to infra/.env for local Compose use. Do not commit infra/.env.
POSTGRES_DB=ai_codereview
POSTGRES_USER=ai_codereview
POSTGRES_PASSWORD=replace-with-a-local-secret
JWT_SECRET=replace-with-a-local-secret-that-is-at-least-32-characters
GENERATION_PROVIDER=fake
EMBEDDING_PROVIDER=fake
# GEMINI_API_KEY=replace-with-a-local-secret
# To enable DeepSeek, set GENERATION_PROVIDER=deepseek and add the key locally.
# DEEPSEEK_API_KEY=replace-with-a-local-secret
# DEEPSEEK_GENERATION_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# HTTP_QUERY tools are disabled until their exact HTTPS host is allowlisted.
# AGENT_TOOL_ALLOWED_HOSTS=["api.example.internal"]
# GitHub source connections are read-only. Create a connection with this environment variable name,
# not the token value; public repositories may omit a secret reference.
# GITHUB_SOURCE_TOKEN=replace-with-a-read-only-github-token
