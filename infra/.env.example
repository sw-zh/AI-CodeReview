# Copy to infra/.env for local Compose use. Do not commit infra/.env.
POSTGRES_DB=ai_codereview
POSTGRES_USER=ai_codereview
POSTGRES_PASSWORD=replace-with-a-local-secret
JWT_SECRET=replace-with-a-local-secret-that-is-at-least-32-characters

# Generation provider: any OpenAI-compatible chat/completions service (deepseek,
# siliconflow, ...). Use the OpenAI interface.
GENERATION_PROVIDER=deepseek
GENERATION_MODEL=deepseek-v4-flash
GENERATION_BASE_URL=https://api.deepseek.com
# GENERATION_API_KEY=replace-with-a-local-secret

# Embedding provider: any OpenAI-compatible /embeddings service (dashscope,
# siliconflow, ...). Use the OpenAI interface.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
# Use the OpenAI-compatible endpoint of your model workspace.
EMBEDDING_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=replace-with-a-local-secret
# Must match the selected embedding model's output dimension (dashscope
# text-embedding-v4 = 768, SiliconFlow BAAI/bge-m3 = 1024). Changing it requires
# re-running migrations (clears stored vectors) and rebuilding retrieval indexes.
EMBEDDING_DIMENSIONS=768

# HTTP_QUERY tools are disabled until their exact HTTPS host is allowlisted.
# AGENT_TOOL_ALLOWED_HOSTS=["api.example.internal"]
# GitHub source connections are read-only. Create a connection with this environment variable name,
# not the token value; public repositories may omit a secret reference.
# GITHUB_SOURCE_TOKEN=replace-with-a-read-only-github-token
